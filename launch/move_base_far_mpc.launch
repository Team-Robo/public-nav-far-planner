<launch>
  <!--
    move_base with the FAR visibility-graph global planner and the teamrobo2027 MPC local planner.
    This is a copy of core-mode_switching_mpc_2027/launch/move_base_mlda_2026.launch; the only
    differences are the base_global_planner (arg global_planner) and loading the FAR parameters.
    Keep it in sync with that file. Example run:
        python3 run.py -l move_base_far_mpc.launch
    Use global_planner:=navfn/NavfnROS to get the original NavFn behaviour back.
  -->
  <arg name="global_planner" default="far_planner/FARPlannerROS" />

  <!-- When false, costmap and laser_scan_to_point_cloud use raw /front/scan. -->
  <arg name="enable_lidar_filter" default="true" />
  <arg name="laser_scan_topic" value="front/scan_filtered" if="$(arg enable_lidar_filter)" />
  <arg name="laser_scan_topic" value="front/scan" unless="$(arg enable_lidar_filter)" />

    <!-- Start the navigation stack -->
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">

        <rosparam file="$(find teamrobo2027)/configs/params/costmap_common_params.yaml"
            command="load" ns="global_costmap" />
        <rosparam file="$(find teamrobo2027)/configs/params/costmap_common_params.yaml"
            command="load" ns="local_costmap" />
        <param name="global_costmap/obstacles_layer/scan/topic" value="$(arg laser_scan_topic)" />
        <param name="local_costmap/obstacles_layer/scan/topic" value="$(arg laser_scan_topic)" />

        <rosparam
            file="$(find teamrobo2027)/configs/params/odom_nav_params/global_costmap_params.yaml"
            command="load" />
        <rosparam
            file="$(find teamrobo2027)/configs/params/odom_nav_params/local_costmap_params.yaml"
            command="load" />

        <rosparam file="$(find teamrobo2027)/configs/params/move_base_params.yaml" command="load" />
        <rosparam file="$(find teamrobo2027)/configs/mpc_local_planner_params.yaml"
            command="load" ns="MpcLocalPlannerROS" />

        <!-- FAR global planner parameters -->
        <rosparam file="$(find far_planner)/config/far_planner_params.yaml"
            command="load" ns="FARPlannerROS" />

        <param name="base_global_planner" type="string" value="$(arg global_planner)" />

        <param name="base_local_planner" value="teamrobo2027/MpcLocalPlannerROS" />
        <param name="NavfnROS/default_tolerance" value="0.1" />
        <remap from="odom" to="odometry/filtered" />
    </node>
    <rosparam file="$(find teamrobo2027)/configs/teamrobo2027_mpc_params.yaml" command="load" />
    <group if="$(arg enable_lidar_filter)">
        <node pkg="teamrobo2027" type="lidar_filter_node" name="lidar_filter" output="screen" />
    </group>
    <node pkg="teamrobo2027" type="laser_scan_to_point_cloud_node" name="laser_scan_to_point_cloud" output="screen">
        <param name="scan_topic" value="/$(arg laser_scan_topic)" />
        <param name="laser_frame" value="front_laser" />
    </node>
    <node pkg="teamrobo2027" type="occupancy_to_cloud_node" name="map_to_cloud" output="screen"></node>
</launch>
